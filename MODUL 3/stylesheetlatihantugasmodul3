* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: Arial, sans-serif; background: #edf1f5; color: #333; padding: 25px 12px; }
.container { max-width: 820px; margin: auto; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 5px 18px rgba(0,0,0,.10); }
header { background: #254b70; color: white; text-align: center; padding: 32px 15px; }
header h1 { margin-bottom: 8px; }
main { padding: 25px; }
section { margin-bottom: 25px; }
h2 { color: #254b70; margin-bottom: 14px; }
table { width: 100%; border-collapse: collapse; }
th, td { text-align: left; padding: 12px; border-bottom: 1px solid #ddd; }
th { width: 35%; color: #254b70; }
section p { line-height: 1.7; text-align: justify; }
footer { background: #254b70; color: white; text-align: center; padding: 15px; }
@media (max-width: 550px) {
  body { padding: 10px 5px; }
  main { padding: 18px; }
  th, td { padding: 9px 6px; }
}
